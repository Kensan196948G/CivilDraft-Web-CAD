{
  "name": "civildraft-web-cad",
  "private": true,
  "version": "0.1.0",
  "description": "CivilDraft — 土木施工図向けWebベース2D CAD",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "migrations:check": "node scripts/validate-migrations.mjs",
    "release:audit": "node scripts/release-audit.mjs",
    "secret:scan": "node scripts/secret-scan.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "dxf-parser": "^1.1.2",
    "dxf-writer": "^1.18.4",
    "konva": "^9.3.22",
    "pdf-lib": "^1.17.1",
    "rbush": "^4.0.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
