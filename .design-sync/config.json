  },
  "componentSrcMap": {
    "Sidebar": "src/app/layout/Sidebar.tsx",
    "CadEditorPage": "src/app/pages/CadEditorPage.tsx",
    "ConstructionStepsPage": "src/app/pages/ConstructionStepsPage.tsx",
    "CrossSectionPage": "src/app/pages/CrossSectionPage.tsx",
    "DrawingComparePage": "src/app/pages/DrawingComparePage.tsx",
    "DrawingSettingsPage": "src/app/pages/DrawingSettingsPage.tsx",
    "HomePage": "src/app/pages/HomePage.tsx",
    "PartsPalettePage": "src/app/pages/PartsPalettePage.tsx",
    "PrintExportPage": "src/app/pages/PrintExportPage.tsx",
    "ProjectDetailPage": "src/app/pages/ProjectDetailPage.tsx",
    "QuantitySummaryPage": "src/app/pages/QuantitySummaryPage.tsx",
    "ReviewApprovalPage": "src/app/pages/ReviewApprovalPage.tsx",
    "SurveyPointsPage": "src/app/pages/SurveyPointsPage.tsx",
    "SystemSettingsPage": "src/app/pages/SystemSettingsPage.tsx"
  }
