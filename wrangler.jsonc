{
  // CivilDraft Web CAD — Cloudflare Workers 配信設定
  // 正本: docs/operations/release-procedure.md §6.1
  //
  // 現在の本番直前方針:
  // - dist/ を Static Assets として配信する SPA 構成は維持する。
  // - Workers API（src/workers/index.ts）はP0契約実装済みだが、本番Neon/R2接続、
  //   Cloudflare Accessテナント設定、Static Assetsとの統合方式が人間決裁前のため、
  //   この設定ではまだ main として有効化しない。
  // デプロイ・wrangler login・リソース作成は人間決裁事項（本ファイルは構成定義のみ）。
  "name": "civildraft-web-cad",
  "compatibility_date": "2026-07-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }

  // --- 本番APIを有効化する際に人間承認後に追加する ---
  // "main": "src/workers/index.ts",
  // 静的アセットへ素通しさせず Worker を先に通す場合の設定例:
  // "assets": {
  //   "directory": "./dist",
  //   "not_found_handling": "single-page-application",
  //   "binding": "ASSETS"
  // }
}
